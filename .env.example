# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATA_DIR=/app/data

# ASR
ASR_PROVIDER=funasr_streaming
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FUNASR_MODEL=paraformer-zh-streaming
FUNASR_DEVICE=cpu
OCI_SPEECH_REGION=
OCI_SPEECH_COMPARTMENT_ID=
OCI_SPEECH_LANGUAGE=zh-CN
OCI_SPEECH_PROFILE=DEFAULT
OCI_SPEECH_CONFIG_FILE=/root/.oci/config
OCI_SPEECH_REALTIME_ENDPOINT=

# Voiceprint
SPEAKER_THRESHOLD=0.30
SPEAKER_MODEL_SAVEDIR=/root/.cache/huggingface/speechbrain/spkrec-ecapa-voxceleb
ENERGY_THRESHOLD=0.008
SILENCE_DURATION_MS=800
MIN_SPEECH_DURATION_MS=1000
PUNCTUATION_SENSITIVITY=0.6
PUNCTUATION_PROVIDER=asr
PUNCTUATION_MODEL=ct-punc
PUNCTUATION_DEVICE=cpu

# Optional: FunASR cam++ speaker diarization is resource-heavy.
# The same option can be toggled in the frontend settings page.
SPEAKER_DIARIZATION_ENABLED=false

# LLM
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
